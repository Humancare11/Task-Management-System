PORT=5000

# --- Local development / test DB (NODE_ENV unset or "development"/"test") ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=your_mysql_password
# optional: run tests against a separate schema
# TEST_DB_NAME=task_manager_test

# --- Production DB (NODE_ENV=production) ---
# REQUIRED on a real deploy. Set these in the hosting environment, NOT here.
# `npm start` / `npm run migrate:prod` will refuse to run (and never fall back
# to localhost) if PROD_DB_HOST / PROD_DB_NAME / PROD_DB_USER are missing.
# PROD_DB_HOST=your-prod-mysql-host
# PROD_DB_PORT=3306
# PROD_DB_NAME=your_prod_db
# PROD_DB_USER=your_prod_user
# PROD_DB_PASSWORD=your_prod_password

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used to sign the express-session cookie (required by passport's session support)
SESSION_SECRET=replace_with_a_long_random_string

# Google OAuth (optional — only needed if you want "Sign in with Google" to work)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# URL of the running frontend — used to redirect back after Google login
FRONTEND_URL=http://localhost:5173

# --- Monitoring: Live Screen (WebRTC) ---
# ICE servers for the peer-to-peer screen stream. MUST include a TURN server in
# production — plain STUN does not connect through symmetric NAT / strict
# firewalls. JSON array of RTCIceServer objects, on one line:
# LIVE_SCREEN_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478","turn:turn.example.com:3478?transport=tcp"],"username":"USER","credential":"PASS"}]
# Optional overrides (ms):
# LIVE_SCREEN_MAX_SESSION_MS=1800000
# LIVE_SCREEN_REQUEST_TIMEOUT_MS=45000

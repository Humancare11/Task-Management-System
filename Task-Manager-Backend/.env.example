PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=task_manager
DB_USER=root
DB_PASSWORD=your_mysql_password

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used to sign the express-session cookie (required by passport's session support)
SESSION_SECRET=replace_with_a_long_random_string

# Google OAuth (optional — only needed if you want "Sign in with Google" to work)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# URL of the running frontend — used to redirect back after Google login
FRONTEND_URL=http://localhost:5173
